+def _attention_continuity_cuda7():
+    import hashlib
+    source = ATT7_CUDA_SRC
+    if hashlib.sha256(source.encode()).hexdigest() != '22c116a45f1817fbaf27a1cc3656380affad49d2cb2367dd23aac83f20b7cef5':
+        raise ValueError("attention control source identity mismatch")
+    edits = [('#define OKC_CONT 0', '#define OKC_CONT 1'), ('template <int L, bool F>\nstruct Smem {', 'template <bool Enabled>\nstruct ContinuityMergeStorage {};\ntemplate <>\nstruct ContinuityMergeStorage<true> {\n  alignas(16) float continuity_merge[64 * 18];\n};\n\ntemplate <int L, bool F>\nstruct Smem : ContinuityMergeStorage<(L == 1 && F && OKC_CONT)> {'), ('if (L == 1 && !CONT && !(OKC_NOXCH1 && !M_CL)) {', 'if (L == 1 && !(OKC_NOXCH1 && !M_CL)) {'), ('    float* xs = reinterpret_cast<float*>(S.k) + ((warp & 1) * 32 + lane) * 18;', '    float* xs;\n    if constexpr (L == 1 && CONT) xs = S.continuity_merge + ((warp & 1) * 32 + lane) * 18;\n    else xs = reinterpret_cast<float*>(S.k) + ((warp & 1) * 32 + lane) * 18;'), ('      mbar_fence_init();\n    }\n  }\n  // segment list in shared memory', '      mbar_fence_init();\n    }\n    __syncthreads();\n  }\n  // segment list in shared memory')]
+    for old, new in edits:
+        if source.count(old) != 1:
+            raise ValueError("attention continuity source anchor mismatch")
+        source = source.replace(old, new, 1)
+    return source
+
+
+def _att7_continuity():
+    global _ATT7_CONTINUITY
+    if _ATT7_CONTINUITY is None:
+        import os
+        from torch.utils.cpp_extension import load_inline
+        major, minor = torch.cuda.get_device_capability()
+        arch = f"{major}{minor}" + ("a" if major >= 9 else "")
+        os.environ["TORCH_CUDA_ARCH_LIST"] = f"{major}.{minor}" + ("a" if major == 9 else "")
+        _ATT7_CONTINUITY = load_inline(name=f"muse_att_cont_merge_3fa5ac28206c_{arch}", cpp_sources=ATT7_CPP_SRC, cuda_sources=_attention_continuity_cuda7(),
+                            functions=["run"], extra_cuda_cflags=["-DOKC_QDIRECT=0", "-DOKC_PK2=0", "-DOKC_W0ENABLE=1", "-O3", f"-DOKC_SM90={1 if major >= 9 else 0}", "--expt-relaxed-constexpr"],
+                            verbose=False)
+    return _ATT7_CONTINUITY
+
