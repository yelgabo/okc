        {
          "additions": 1,
          "blob_url": "https://github.com/djmmoss/vllm/blob/31ebba9843cd6341d50434310d25b371eb2a12de/vllm%2Fmodels%2Fmuse_spark%2Fnvidia%2Fspecialized_decode%2Fcutedsl%2Fattention%2Fqkv_front.py",
          "deletions": 1,
          "filename": "vllm/models/muse_spark/nvidia/specialized_decode/cutedsl/attention/qkv_front.py",
          "patch": "@@ -544,7 +544,7 @@ def consume(self, sbase, fb, eb, warp, lane, acc) -> None:\n     def send(self, acc, s_recv, rb, warp, lane, rank, ntok_max, active_m) -> None:\n         \"\"\"This CTA's partial of rows 16 warp + g (+8) for tokens 8 nt + 2 t\n         (+1), the k-block sets summed in fixed order, into the owner rank's\n-        receive slot [rank][token / splits][row]: rows (r, r + 1) of one token\n+        receive slot `[rank][token / splits][row]`: rows (r, r + 1) of one token\n         per lane, paired by one xor-4 shuffle (lanes g and g ^ 1 share t).\"\"\"\n         splits = self.splits\n         g = lane >> 2",
